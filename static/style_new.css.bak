/* =========================================
   1. VARIABLES & RESET
   ========================================= */
:root {
    --primary: #0d47a1;
    --primary-light: #1565c0;
    --accent: #00bcd4;
    --accent-dark: #0097a7;
    --yellow: #ffc107;
    --yellow-dark: #ffb300;
    --success: #27ae60;
    --warning: #f39c12;
    --danger: #e74c3c;
    --light-bg: #0f1419;
    --dark-text: #ffffff;
    --white: #ffffff;
    --border-gray: rgba(255, 255, 255, 0.2);
    --glass-bg: rgba(13, 71, 161, 0.1);
    --glass-border: rgba(255, 255, 255, 0.15);
    --shadow-light: 0 2px 8px rgba(0,0,0,0.08);
    --shadow-medium: 0 4px 16px rgba(0,0,0,0.12);
    --shadow-large: 0 8px 32px rgba(0,0,0,0.15);
    --transition: 0.3s ease;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Segoe UI', 'Roboto', sans-serif;
    scroll-behavior: smooth;
}

body {
    background: url('/static/images/busbg.png') center/cover fixed;
    background-color: #0a0f1a;
    min-height: 100vh;
    color: var(--dark-text);
    overflow-x: hidden;
}

/* =========================================
   2. NAVIGATION (Enhanced Glassmorphism)
   ========================================= */
.glass-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 8%;
    background: rgba(13, 71, 161, 0.15);
    backdrop-filter: blur(15px);
    position: fixed;
    width: 100%;
    top: 0;
    z-index: 1000;
    transition: var(--transition);
    border-bottom: 1px solid rgba(255, 193, 7, 0.2);
}

.glass-nav.scrolled {
    padding: 0.8rem 8%;
    background: rgba(13, 71, 161, 0.25);
    backdrop-filter: blur(25px);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
}

.logo { 
    height: 45px; 
    transition: 0.3s; 
}

.glass-nav.scrolled .logo { 
    height: 38px; 
}

.nav-links { 
    display: flex; 
    align-items: center; 
    list-style: none; 
    gap: 35px; 
}

.nav-links a { 
    text-decoration: none; 
    color: white; 
    font-weight: 600; 
    font-size: 0.95rem; 
    transition: var(--transition);
    position: relative;
}

.nav-links a:hover { 
    color: var(--yellow);
}

.nav-links a::after {
    content: '';
    position: absolute;
    bottom: -3px;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--yellow);
    transition: width 0.3s ease;
}

.nav-links a:hover::after {
    width: 100%;
}

.login-btn { 
    background: linear-gradient(135deg, var(--yellow), var(--yellow-dark));
    color: #000;
    padding: 10px 25px; 
    border: none;
    border-radius: 50px; 
    cursor: pointer;
    font-weight: 600;
    transition: var(--transition);
    box-shadow: 0 4px 15px rgba(255, 193, 7, 0.4);
}

.login-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(255, 193, 7, 0.6);
}

/* =========================================
   3. HERO & SERVICE CARDS
   ========================================= */
.hero { 
    height: 65vh;
    background: linear-gradient(rgba(0, 0, 0, 0.3), rgba(0, 0, 0, 0.3));
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: white;
    padding: 2rem;
    border-bottom: none;
}

.hero h1 {
    font-size: 3.5rem;
    margin-bottom: 1rem;
    font-weight: 800;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.3);
}

.hero p {
    font-size: 1.3rem;
    opacity: 0.95;
    max-width: 600px;
    text-shadow: 0 1px 5px rgba(0, 0, 0, 0.2);
}

.services-container { 
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2.5rem; 
    padding: 3rem 8% 4rem; 
    margin-top: -50px;
    position: relative;
    z-index: 10;
}

.glass-card {
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(20px);
    border-radius: 15px;
    padding: 2.5rem;
    text-align: center;
    border: 1px solid rgba(255, 193, 7, 0.3);
    transition: var(--transition);
    cursor: pointer;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
}

.glass-card:hover { 
    transform: translateY(-12px); 
    box-shadow: 0 16px 40px rgba(255, 193, 7, 0.3);
    border-color: var(--yellow);
    background: rgba(255, 255, 255, 0.15);
}

.glass-card h2 {
    color: var(--yellow);
    margin: 1rem 0;
    font-size: 1.4rem;
}

.glass-card p {
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.95rem;
    line-height: 1.6;
}

.glow-icon { 
    font-size: 3rem; 
    color: var(--yellow); 
    margin-bottom: 1rem;
}

.main-content {
    position: relative;
    z-index: 1;
}

/* =========================================
   4. INFO SECTIONS
   ========================================= */
.info-section { 
    padding: 4rem 8%; 
}

.glass-content {
    background: rgba(13, 71, 161, 0.15);
    backdrop-filter: blur(25px);
    padding: 3.5rem;
    border-radius: 15px;
    border: 1px solid rgba(255, 193, 7, 0.3);
    text-align: center;
    color: white;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
}

.glass-content h2 {
    font-size: 2rem;
    margin-bottom: 1.5rem;
    color: var(--yellow);
}

.glass-content p {
    font-size: 1.05rem;
    line-height: 1.8;
    opacity: 0.95;
}

.glass-content a {
    color: var(--yellow);
    text-decoration: none;
    font-weight: 600;
}

.contact-details p {
    margin: 10px 0;
    font-size: 1.05rem;
}

.contact-details i {
    color: var(--yellow);
    margin-right: 10px;
}

/* =========================================
   5. MODAL SYSTEM
   ========================================= */
.modal-overlay {
    position: fixed;
    top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(10px);
    display: none;
    justify-content: center;
    align-items: center;
    z-index: 3000;
}

.login-card {
    background: rgba(13, 71, 161, 0.2);
    backdrop-filter: blur(40px);
    border: 1px solid rgba(255, 193, 7, 0.4);
    width: 90%;
    max-width: 420px;
    padding: 3rem;
    border-radius: 20px;
    position: relative;
    text-align: center;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
    color: white;
}

.close-modal { 
    position: absolute; 
    top: 20px; right: 20px; 
    background: none; 
    border: none; 
    color: rgba(255, 255, 255, 0.8); 
    font-size: 1.8rem; 
    cursor: pointer;
    transition: var(--transition);
}

.close-modal:hover {
    color: var(--danger);
}

.login-card h2 {
    color: var(--yellow);
    margin-bottom: 2rem;
    font-size: 1.8rem;
}

/* Auth Forms */
.auth-form { 
    display: flex; 
    flex-direction: column; 
    gap: 1.2rem; 
}

.input-group { 
    position: relative; 
}

.input-group i { 
    position: absolute; 
    left: 15px; top: 50%; 
    transform: translateY(-50%); 
    color: var(--yellow); 
    font-size: 1rem;
}

.input-group .password-toggle {
    left: auto;
    right: 15px;
    cursor: pointer;
    color: rgba(255, 255, 255, 0.75);
}

.input-group input { 
    width: 100%; 
    padding: 12px 15px 12px 45px; 
    background: rgba(255, 255, 255, 0.1); 
    border: 1px solid rgba(255, 193, 7, 0.3); 
    border-radius: 8px; 
    color: white; 
    outline: none;
    transition: var(--transition);
    font-size: 0.95rem;
}

.input-group input:focus {
    border-color: var(--yellow);
    background: rgba(255, 255, 255, 0.15);
}

.input-group input::placeholder {
    color: rgba(255, 255, 255, 0.75);
}

.strength-meter { 
    height: 4px; 
    background: #e0e0e0; 
    margin-top: 8px; 
    border-radius: 2px; 
    overflow: hidden;
}

#strength-bar { 
    height: 100%; 
    width: 0%; 
    transition: 0.4s;
    background: linear-gradient(90deg, var(--danger), var(--warning), var(--success));
}

.auth-btn { 
    width: 100%; 
    padding: 14px; 
    background: linear-gradient(135deg, var(--yellow), var(--yellow-dark));
    border: none; 
    border-radius: 8px; 
    color: white; 
    font-weight: 700; 
    cursor: pointer; 
    transition: var(--transition);
    font-size: 1rem;
    box-shadow: var(--shadow-medium);
}

.auth-btn:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-large);
}

.auth-form > p {
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.9rem;
    margin-top: 1rem;
}

.auth-form > p a {
    color: var(--yellow);
    text-decoration: none;
    font-weight: 600;
}

/* =========================================
   6. SCHEDULE TABLE STYLES (MODERN CARDS)
   ========================================= */
.schedule-main {
    padding: 8rem 8% 4rem;
    display: flex;
    justify-content: center;
}

.schedule-container {
    background: rgba(255, 255, 255, 0.07);
    backdrop-filter: blur(25px);
    width: 100%;
    max-width: 1200px;
    padding: 3rem;
    border-radius: 15px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
    color: white;
    border: 1px solid rgba(255, 193, 7, 0.2);
}

.schedule-title {
    text-align: center;
    color: var(--yellow);
    font-size: 2.2rem;
    margin-bottom: 2.5rem;
    font-weight: 700;
}

/* Bus Cards Grid */
.buses-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: 2rem;
    margin-bottom: 2rem;
}

.bus-card {
    border: 1px solid rgba(255, 193, 7, 0.3);
    border-radius: 12px;
    padding: 1.8rem;
    transition: var(--transition);
    cursor: pointer;
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(15px);
}

.bus-card:hover {
    border-color: var(--yellow);
    box-shadow: 0 12px 32px rgba(255, 193, 7, 0.4);
    transform: translateY(-5px);
    background: rgba(255, 255, 255, 0.12);
}

.bus-card-header {
    display: flex;
    justify-content: space-between;
    align-items: start;
    margin-bottom: 1.5rem;
}

.bus-number {
    background: linear-gradient(135deg, var(--primary), var(--primary-light));
    color: white;
    padding: 8px 16px;
    border-radius: 50px;
    font-weight: 700;
    font-size: 0.9rem;
}

.bus-route {
    color: var(--yellow);
    font-size: 1.2rem;
    font-weight: 700;
}

.bus-times {
    display: flex;
    gap: 2rem;
    margin: 1.2rem 0;
    padding: 1rem 0;
    border-top: 1px solid rgba(255, 193, 7, 0.2);
    border-bottom: 1px solid rgba(255, 193, 7, 0.2);
}

.time-box {
    flex: 1;
}

.time-label {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.6);
    text-transform: uppercase;
    margin-bottom: 0.3rem;
}

.time-value {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--yellow);
}

.bus-price {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 1.5rem;
}

.price {
    font-size: 1.8rem;
    color: var(--yellow);
    font-weight: 700;
}

.book-now-btn {
    background: linear-gradient(135deg, var(--yellow), var(--yellow-dark));
    color: white;
    border: none;
    padding: 12px 28px;
    border-radius: 8px;
    cursor: pointer;
    font-weight: 700;
    transition: var(--transition);
    box-shadow: var(--shadow-medium);
    text-decoration: none;
    display: inline-block;
}

.book-now-btn:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-large);
}

/* Table Fallback */
.bus-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 20px;
    display: none;
}

.bus-table th {
    background: linear-gradient(135deg, var(--primary), var(--primary-light));
    color: white;
    text-align: left;
    padding: 15px;
    font-weight: 700;
}

.bus-table td {
    padding: 15px;
    border-bottom: 1px solid var(--border-gray);
    color: #444;
}

.bus-table tr:hover {
    background: #f5f5f5;
}

/* =========================================
   7. BOOKING PAGE
   ========================================= */
.glass-booking-card {
    background: rgba(255, 255, 255, 0.07) !important;
    backdrop-filter: blur(25px) !important;
    border: 1px solid rgba(255, 193, 7, 0.2) !important;
}

.bus-grid-header {
    background: linear-gradient(135deg, var(--primary), var(--primary-light));
    color: white;
    padding: 15px 20px;
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 2rem;
    border-radius: 8px;
}

.booking-input-group {
    display: flex;
    flex-direction: column;
    margin-bottom: 1.5rem;
}

.booking-input-group label {
    font-weight: 700;
    color: var(--yellow);
    margin-bottom: 0.5rem;
    font-size: 1rem;
}

.booking-input-group input {
    padding: 12px 15px;
    border: 2px solid #ddd;
    border-radius: 8px;
    font-size: 1rem;
    transition: var(--transition);
    background: white;
    color: #333;
    width: 100%;
}

.booking-input-group input::placeholder {
    color: #999;
}

.booking-input-group input:focus {
    outline: none;
    border-color: var(--yellow);
    background: white;
    box-shadow: 0 0 8px rgba(255, 193, 7, 0.3);
}

.seat-selection-wrapper {
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(15px);
    border: 1px solid rgba(255, 193, 7, 0.2);
    border-radius: 12px;
    margin: 2rem 0;
    overflow: hidden;
}

.selection-subtitle {
    color: var(--yellow);
    font-size: 1.2rem;
    font-weight: 700;
    margin: 1.5rem 0 1rem;
}

.seat-grid {
    display: grid;
    grid-template-columns: repeat(10, 1fr);
    gap: 12px;
    padding: 20px;
    max-width: 700px;
}

/* Bus Layout Styling */
.bus-layout {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.02));
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 193, 7, 0.2);
    border-radius: 15px;
    padding: 2rem;
    max-width: 500px;
    margin: 0 auto;
}

.driver-area {
    background: linear-gradient(135deg, var(--primary), var(--primary-light));
    color: white;
    padding: 1.5rem;
    border-radius: 12px;
    text-align: center;
    font-weight: 700;
    margin-bottom: 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
}

.driver-area i {
    font-size: 1.5rem;
}

.seat-row {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 1.2rem;
}

.seat-pair {
    display: flex;
    gap: 0.8rem;
}

.aisle {
    width: 1px;
    height: 70px;
    background: linear-gradient(180deg, transparent, rgba(255, 193, 7, 0.3), transparent);
    border: 1px dashed rgba(255, 193, 7, 0.4);
}

/* Seat Legend */
.seat-legend {
    display: inline-block;
    width: 16px;
    height: 16px;
    border-radius: 4px;
    margin-right: 0.5rem;
    vertical-align: middle;
}

.seat-legend.available {
    background: rgba(255, 193, 7, 0.3);
    border: 1px solid rgba(255, 193, 7, 0.6);
}

.seat-legend.booked {
    background: rgba(231, 76, 60, 0.3);
    border: 1px solid rgba(231, 76, 60, 0.6);
}

.seat-box {
    width: 50px;
    height: 50px;
    background: rgba(255, 255, 255, 0.1);
    border: 2px solid rgba(255, 193, 7, 0.3);
    cursor: pointer;
    transition: var(--transition);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    border-radius: 8px;
    color: white;
    flex-direction: column;
    position: relative;
}

.seat-number {
    font-size: 1.2rem;
    font-weight: 800;
    color: white;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
}

.seat-label {
    font-size: 0.5rem;
    font-weight: 700;
    letter-spacing: 1px;
    color: rgba(255, 255, 255, 0.9);
}

.seat-box:hover {
    border-color: var(--yellow);
    background: rgba(255, 193, 7, 0.15);
    transform: scale(1.05);
    box-shadow: 0 4px 12px rgba(255, 193, 7, 0.3);
}

.seat-box.selected {
    background: linear-gradient(135deg, var(--yellow), var(--yellow-dark));
    color: #000;
    border-color: var(--yellow);
    box-shadow: 0 0 15px rgba(255, 193, 7, 0.6);
}

.seat-box.booked {
    background: rgba(231, 76, 60, 0.3);
    border-color: rgba(231, 76, 60, 0.6);
    cursor: not-allowed;
    color: rgba(255, 255, 255, 0.5);
    opacity: 0.7;
}

.seat-box.booked:hover {
    border-color: rgba(231, 76, 60, 0.6);
    background: rgba(231, 76, 60, 0.3);
    cursor: not-allowed;
}

.confirm-booking-btn {
    background: linear-gradient(135deg, var(--success), #229954);
    color: white;
    padding: 14px 40px;
    border: none;
    border-radius: 8px;
    font-size: 1.1rem;
    font-weight: 700;
    cursor: pointer;
    margin-top: 2rem;
    transition: var(--transition);
    box-shadow: var(--shadow-medium);
}

.confirm-booking-btn:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-large);
}

/* =========================================
   8. DASHBOARD PAGES
   ========================================= */
.dashboard-header {
    margin-bottom: 2rem;
    color: white;
}

.dashboard-header p {
    color: rgba(255, 255, 255, 0.8);
}

.dashboard-header h1 {
    font-size: 2rem;
    color: var(--yellow);
    margin-bottom: 0.5rem;
}

.user-actions {
    margin-bottom: 2rem;
}

.print-btn, .cancel-btn {
    padding: 12px 28px;
    border: none;
    border-radius: 8px;
    font-weight: 700;
    cursor: pointer;
    transition: var(--transition);
    text-decoration: none;
    display: inline-block;
    margin-right: 1rem;
    box-shadow: var(--shadow-medium);
}

.print-btn {
    background: linear-gradient(135deg, var(--yellow), var(--yellow-dark));
    color: #000;
    font-weight: 700;
}

.print-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(255, 193, 7, 0.5);
}

.cancel-btn {
    background: #ffb399;
    color: white;
}

.cancel-btn:hover {
    background: #ff9d80;
    transform: translateY(-2px);
}

/* Table Styling */
.table-container {
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(15px);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
    margin: 2rem 0;
    border: 1px solid rgba(255, 193, 7, 0.2);
}

.table-header {
    padding: 18px 20px;
    font-weight: 700;
    font-size: 1.1rem;
    background: linear-gradient(135deg, var(--primary), var(--primary-light));
    color: white;
}

.admin-table {
    width: 100%;
    border-collapse: collapse;
}

.admin-table th {
    text-align: left;
    padding: 15px 20px;
    background: rgba(255, 193, 7, 0.15);
    border-bottom: 1px solid rgba(255, 193, 7, 0.3);
    font-weight: 700;
    color: var(--yellow);
    font-size: 0.9rem;
    text-transform: uppercase;
}

.admin-table td {
    padding: 15px 20px;
    border-bottom: 1px solid rgba(255, 193, 7, 0.1);
    color: rgba(255, 255, 255, 0.9);
}

.admin-table tr:hover {
    background: rgba(255, 193, 7, 0.05);
}

.admin-table tr:nth-child(even) {
    background: rgba(255, 255, 255, 0.03);
}

.status-confirmed {
    color: var(--success);
    font-weight: 700;
}

.status-paid {
    color: var(--success);
    font-weight: 700;
}

.status-cancelled {
    color: var(--danger);
    font-weight: 700;
}

.status-pending {
    color: var(--warning);
    font-weight: 700;
}

/* =========================================
   9. ADMIN DASHBOARD
   ========================================= */
.admin-body {
    background: var(--light-bg);
}

.admin-wrapper {
    display: flex;
    min-height: 100vh;
    gap: 2rem;
    padding: 2rem;
}

.sidebar {
    width: 260px;
    background: rgba(13, 71, 161, 0.2);
    backdrop-filter: blur(25px);
    padding: 2rem;
    border-radius: 15px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
    height: fit-content;
    position: sticky;
    top: 2rem;
    border: 1px solid rgba(255, 193, 7, 0.3);
}

.sidebar-logo {
    text-align: center;
    margin-bottom: 2rem;
}

.sidebar-logo img {
    width: 100%;
    max-width: 180px;
}

.sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.sidebar-nav a {
    text-decoration: none;
    color: white;
    background: rgba(255, 193, 7, 0.1);
    padding: 12px 18px;
    border-radius: 8px;
    font-weight: 600;
    text-align: center;
    transition: var(--transition);
    border: 1px solid rgba(255, 193, 7, 0.2);
}

.sidebar-nav a:hover,
.sidebar-nav a.active {
    background: linear-gradient(135deg, var(--yellow), var(--yellow-dark));
    border-color: var(--yellow);
}

.logout-link {
    margin-top: 2rem;
}

.admin-content {
    flex: 1;
}

.admin-content .glass-card {
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(15px);
    color: white;
    border: 1px solid rgba(255, 193, 7, 0.2);
}

.admin-content .glass-card input,
.admin-content .glass-card select {
    width: 100%;
    padding: 12px;
    margin-bottom: 1rem;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 193, 7, 0.3);
    border-radius: 8px;
    font-size: 0.95rem;
    color: white;
}

.admin-content .glass-card input::placeholder,
.admin-content .glass-card select::placeholder {
    color: rgba(255, 255, 255, 0.6);
}

.admin-content .glass-card input:focus,
.admin-content .glass-card select:focus {
    outline: none;
    border-color: var(--yellow);
    background: rgba(255, 255, 255, 0.12);
}

/* =========================================
   10. FOOTER
   ========================================= */
.main-footer {
    background: rgba(13, 30, 55, 0.95);
    backdrop-filter: blur(20px);
    padding: 4rem 8% 1rem;
    color: white;
    border-top: 1px solid rgba(255, 193, 7, 0.2);
    margin-top: 5rem;
}

.footer-content {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 3rem;
    max-width: 1400px;
    margin: 0 auto 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid rgba(255, 193, 7, 0.1);
}

.footer-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.footer-brand {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.footer-logo {
    height: 50px;
    object-fit: contain;
}

.footer-brand h3 {
    font-size: 1.5rem;
    color: var(--yellow);
    font-weight: 700;
    margin: 0;
}

.footer-description {
    font-size: 0.9rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
}

.footer-title {
    font-size: 1.1rem;
    color: var(--yellow);
    font-weight: 700;
    margin: 0 0 1rem 0;
    text-transform: capitalize;
}

.footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    padding: 0;
    margin: 0;
}

.footer-links a {
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
    font-size: 0.95rem;
    transition: var(--transition);
}

.footer-links a:hover {
    color: var(--yellow);
    padding-left: 0.5rem;
}

.footer-contact {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.footer-contact p {
    margin: 0;
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.8);
    display: flex;
    align-items: center;
    gap: 0.8rem;
}

.footer-contact i {
    color: var(--yellow);
    font-size: 1.1rem;
    min-width: 20px;
}

.footer-contact a {
    color: var(--yellow);
    text-decoration: none;
    transition: var(--transition);
}

.footer-contact a:hover {
    opacity: 0.8;
}

.footer-socials {
    display: flex;
    gap: 1.5rem;
    margin-top: 0.5rem;
}

.footer-socials a {
    color: var(--yellow);
    font-size: 1.3rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: rgba(255, 193, 7, 0.1);
    border-radius: 50%;
    transition: var(--transition);
    border: 1px solid rgba(255, 193, 7, 0.3);
}

.footer-socials a:hover {
    background: rgba(255, 193, 7, 0.3);
    transform: translateY(-3px);
}

.footer-bottom {
    text-align: center;
    padding: 2rem 0 1rem;
    opacity: 0.7;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.7);
}

.footer-bottom p {
    margin: 0;
}

.footer-bottom a {
    color: var(--yellow);
    text-decoration: none;
    transition: var(--transition);
}

.footer-bottom a:hover {
    text-decoration: underline;
}

/* =========================================
   11. BACK TO TOP BUTTON
   ========================================= */
#backToTop {
    position: fixed;
    bottom: 40px;
    right: 40px;
    display: none;
    background: linear-gradient(135deg, var(--yellow), var(--yellow-dark));
    color: white;
    border: none;
    border-radius: 50%;
    width: 50px;
    height: 50px;
    font-size: 1.3rem;
    cursor: pointer;
    box-shadow: 0 8px 32px rgba(255, 193, 7, 0.4);
    transition: var(--transition);
    z-index: 2000;
    align-items: center;
    justify-content: center;
}

#backToTop:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 40px rgba(255, 193, 7, 0.5);
}

/* =========================================
   12. RESPONSIVE DESIGN
   ========================================= */
@media (max-width: 768px) {
    .nav-links {
        gap: 15px;
    }
    
    .services-container {
        grid-template-columns: 1fr;
    }
    
    .buses-grid {
        grid-template-columns: 1fr;
    }
    
    .schedule-container {
        padding: 1.5rem;
    }
    
    .admin-wrapper {
        flex-direction: column;
    }
    
    .sidebar {
        width: 100%;
    }
    
    .hero h1 {
        font-size: 2rem;
    }
    
    .schedule-title {
        font-size: 1.5rem;
    }
    
    /* Bus Layout Responsive */
    .bus-layout {
        padding: 1.5rem;
        max-width: 100%;
    }
    
    .seat-box {
        width: 45px;
        height: 45px;
        font-size: 0.85rem;
    }
    
    .seat-number {
        font-size: 0.9rem;
    }
    
    .seat-label {
        font-size: 0.4rem;
    }
    
    .aisle {
        height: 55px;
    }
    
    .seat-row {
        gap: 1rem;
        margin-bottom: 1rem;
    }
    
    .seat-pair {
        gap: 0.6rem;
    }
}
